         // are drawn where the game put them, as its scene is.
+#if RT64_SKIP_CAMERA_CUTS
+        for (const std::pair<uint32_t, uint32_t> &drawnPair : drawnPairs) {
+            GameFrameMap::WorkloadMap &workloadMap = frameMap.workloads[drawnPair.first];
+            workloadMap.cameraCut = workloadMap.cameraCut && !workloadMap.cameraMoved;
+        }
+#endif
+
 #if RT64_INTERPOLATE_RECT_SCROLLS
         for (const std::pair<uint32_t, uint32_t> &drawnPair : drawnPairs) {
             if (frameMap.workloads[drawnPair.first].cameraCut) {
@@ -2417,6 +2441,8 @@ namespace RT64 {
                                 return;
                             }
 
+                            firstCurWorkloadMap.cameraMoved = firstCurWorkloadMap.cameraMoved || movedOn(move.step, prevEyeStep);
