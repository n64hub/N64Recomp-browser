--- a/src/hle/rt64_game_frame.cpp
+++ b/src/hle/rt64_game_frame.cpp
@@ -327,6 +327,22 @@ namespace RT64 {
         return false;
     }
 
+    // Whether a camera that wasn't judged a cut moved on from the frame before as a camera does: its step and the one
+    // before it are known, and it moved. Its workload's other cameras judged cuts then cut only their own scenes, and
+    // its rects pair (GameFrameMap::WorkloadMap::cameraMoved). A game can draw each thing with a view of its own, the
+    // camera's with the thing's place in it: Excitebike 64 draws each rider and bike so in a race, 5-9 cameras a
+    // frame that turn together. Scenes pair with the frame before's in their order, so a rider that came into view
+    // had no step before (-1, and any step over 8 near plane distances was a jump) and one that changed places in the
+    // order was judged against another's step: a rider 15 near plane distances from where it was beside one that had
+    // moved 3.7. Each was judged a cut, and the frame's rects held for its frames between while the world went on: the
+    // place arrow over the rider ahead stopped and jumped as it swept 8-21 pixels a game frame. A real cut moves every
+    // camera by the jump, so a camera moving more than a quarter as fast as that to begin with is all that hides one,
+    // and one held still (a 3D model on a HUD) never vouches for a frame.
+    static bool movedOn(float step, float prevEyeStep) {
+        const float MinMovedStep = 0.05f;
+        return (step >= MinMovedStep) && (prevEyeStep >= 0.0f);
+    }
+
     struct CameraMove {
         float nearDistance = 0.0f;
         float turnCosine = 1.0f;
@@ -2120,6 +2136,7 @@ namespace RT64 {
             workloadMap.prevWorkloadIndex = drawnPair.second;
