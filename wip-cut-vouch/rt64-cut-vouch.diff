                             if (move.step < 0.0f) {
@@ -2653,6 +2679,8 @@ namespace RT64 {
                 firstCurWorkloadMap.cameraCut = true;
                 return;
             }
+
+            firstCurWorkloadMap.cameraMoved = firstCurWorkloadMap.cameraMoved || movedOn(viewProjMap.eyeStep, worldStepPrevEyeStep);
