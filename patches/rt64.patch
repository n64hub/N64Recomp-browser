+                    if (usesViewport && curFrame.matched) {
+                        const uint64_t key = (uint64_t(workloadIndex) << 40) | (uint64_t(f) << 20) | p;
+                        auto it = sceneFirstWorkload.find(key);
+                        const uint32_t firstIndex = (it != sceneFirstWorkload.end()) ? it->second : workloadIndex;
+                        if (firstIndex < maps.size()) {
+                            const std::vector<GameFrameMap::ViewProjectionMap> &viewProjs = maps[firstIndex].viewProjections;
+                            if ((proj.transformsIndex < viewProjs.size()) && viewProjs[proj.transformsIndex].mapped) {
+                                snprintf(viewProjPrev, sizeof(viewProjPrev), "%u", viewProjs[proj.transformsIndex].prevTransformIndex);
+                            }
+                        }
+                    }
+
+                    for (uint32_t d = 0; d < proj.gameCallCount; d++) {
+                        const GameCall &call = proj.gameCalls[d];
+                        const DrawCall &desc = call.callDesc;
+                        const char type = callType(proj, call);
+                        char world[64] = "-\t-\t-\t-";
+                        if (usesViewport) {
+                            char worldPrev[16] = "-";
+                            char worldFlags[4] = "-";
+                            if ((map != nullptr) && (desc.minWorldMatrix < map->transforms.size())) {
+                                const GameFrameMap::TransformMap &transformMap = map->transforms[desc.minWorldMatrix];
+                                if (transformMap.mapped) {
+                                    snprintf(worldPrev, sizeof(worldPrev), "%u", transformMap.prevTransformIndex);
+                                }
+
+                                int flagCount = 0;
+                                if (transformMap.moved) {
+                                    worldFlags[flagCount++] = 'm';
+                                }
+
+                                if (transformMap.verticesStill) {
+                                    worldFlags[flagCount++] = 's';
+                                }
+
+                                if (flagCount > 0) {
+                                    worldFlags[flagCount] = '\0';
+                                }
+                            }
+
+                            snprintf(world, sizeof(world), "%u\t%u\t%s\t%s", desc.minWorldMatrix, desc.maxWorldMatrix, worldPrev, worldFlags);
+                        }
+
+                        char tiles[64] = "-\t0\t-\t0";
+                        if ((desc.tileCount > 0) && (desc.tileIndex < drawData.callTiles.size())) {
+                            bool copy = false;
+                            bool synced = false;
+                            for (uint32_t t = 0; (t < desc.tileCount) && ((desc.tileIndex + t) < drawData.callTiles.size()); t++) {
+                                copy = copy || drawData.callTiles[desc.tileIndex + t].tileCopyUsed;
+                                synced = synced || drawData.callTiles[desc.tileIndex + t].syncRequired;
+                            }
+
+                            const bool tilePaired = (map != nullptr) && (desc.tileIndex < map->tiles.size()) && map->tiles[desc.tileIndex].mapped;
+                            snprintf(tiles, sizeof(tiles), "%016llx\t%u\t%s\t%d", (unsigned long long)(drawData.callTiles[desc.tileIndex].tmemHashOrID), desc.tileCount,
+                                copy ? (synced ? "cs" : "c") : (synced ? "s" : "-"), tilePaired ? 1 : 0);
+                        }
+
+                        char rectMove[80] = "-";
+                        if ((map != nullptr) && (desc.callIndex < map->rectMoves.size())) {
+                            const hlslpp::float4 &move = map->rectMoves[desc.callIndex];
+                            if ((float(move.x) != 0.0f) || (float(move.y) != 0.0f) || (float(move.z) != 0.0f) || (float(move.w) != 0.0f)) {
+                                snprintf(rectMove, sizeof(rectMove), "%.2f,%.2f,%.2f,%.2f", float(move.x), float(move.y), float(move.z), float(move.w));
+                            }
+                        }
+
+                        char rect[80] = "-";
+                        if ((type == 'R') || (type == 'F')) {
+                            snprintf(rect, sizeof(rect), "%.2f,%.2f,%.2f,%.2f", desc.rect.ulx / 4.0f, desc.rect.uly / 4.0f, desc.rect.lrx / 4.0f, desc.rect.lry / 4.0f);
+                        }
+
+                        appendLine(drawsText, "C\t%llu\t%u\t%u\t%c\t%u\t%u\t%s\t%s\t%s\t%s\t%s\t%s\n", workloadId, f, p, type, desc.callIndex, desc.triangleCount,
+                            usesViewport ? std::to_string(proj.transformsIndex).c_str() : "-", viewProjPrev, world, tiles, rectMove, rect);
+                    }
+                }
+            }
+        }
+    }
+
+    void FrameDump::addRenderedFrame(uint32_t frame, float weight) {
+        if (!drawsOn) {
+            return;
+        }
+
+        appendLine(drawsText, "R\t%u\t%u\t%.4f\n", drawsRendered++, frame, weight);
+        drawsFbWorkload = nullptr;
+    }
+
+    void FrameDump::addDraw(const Workload &workload, uint32_t fbPairIndex, const Projection &proj, const GameCall &call, char type,
+        int32_t left, int32_t top, int32_t right, int32_t bottom, float scaleX, float scaleY, float offsetX, float offsetY,
+        float targetWidth, float targetHeight, float resolutionScaleX, float resolutionScaleY, uint32_t colorWidth, uint32_t colorHeight,
+        float aspectRatioScale)
+    {
+        if (!drawsThread || !drawsOn || (drawsRendered == 0)) {
+            return;
+        }
+
+        const unsigned long long workloadId = (unsigned long long)(workload.workloadId);
+        if ((drawsFbWorkload != &workload) || (drawsFbPairIndex != fbPairIndex)) {
+            drawsFbWorkload = &workload;
+            drawsFbPairIndex = fbPairIndex;
+            appendLine(drawsText, "B\t%llu\t%u\t%08x\t%.0f\t%.0f\t%.0f\t%.0f\n", workloadId, fbPairIndex,
+                workload.fbPairs[fbPairIndex].colorImage.address, targetWidth, targetHeight, float(colorWidth) * resolutionScaleX,
+                float(colorHeight) * resolutionScaleY);
+        }
+
+        // Where in the target, before the scissor: a fill rect's is its rect, a rect's its quad from -1 to 1 placed by the
+        // screen scale and offset (RasterVS.hlsl skips its vertices' transform), and triangles the box of what of them lies past
+        // the near plane.
+        const DrawCall &desc = call.callDesc;
+        const DrawData &drawData = workload.drawData;
+        // posScreen is in the game's pixels across the target's whole size (FramebufferRenderer's fbParams.resolution).
+        const float fbWidth = (resolutionScaleX > 0.0f) ? (targetWidth / resolutionScaleX) : 0.0f;
+        const float fbHeight = (resolutionScaleY > 0.0f) ? (targetHeight / resolutionScaleY) : 0.0f;
+        float x0 = float(left), y0 = float(top), x1 = float(right), y1 = float(bottom);
+        auto toTarget = [&](float ndcX, float ndcY, float &x, float &y) {
+            x = ((ndcX * scaleX + offsetX) + 1.0f) * targetWidth * 0.5f;
+            y = (1.0f - (ndcY * scaleY + offsetY)) * targetHeight * 0.5f;
+        };
+
+        if (type == 'R') {
+            toTarget(-1.0f, 1.0f, x0, y0);
+            toTarget(1.0f, -1.0f, x1, y1);
+        }
+        else if (((type == 'P') || (type == 'O')) && (desc.triangleCount > 0) && (fbWidth > 0.0f) && (fbHeight > 0.0f)) {
+            // The projection's x is narrowed about its viewport's centre where ProjectionProcessor widens the picture
+            // (a viewport across the scissor's width at G_EX_ASPECT_AUTO, or G_EX_ASPECT_ADJUST): posScreen is the game's.
+            float narrowing = 1.0f;
+            const interop::RSPViewport &viewport = drawData.rspViewports[proj.transformsIndex];
+            if (aspectRatioScale != 1.0f) {
+                const TransformGroup &group = drawData.transformGroups[drawData.viewProjTransformGroups[proj.transformsIndex]];
+                bool adjust = (group.aspectMode == G_EX_ASPECT_ADJUST);
+                if (group.aspectMode == G_EX_ASPECT_AUTO) {
+                    const FramebufferPair &fbPair = workload.fbPairs[fbPairIndex];
+                    const int16_t *viewportClipRatios = &drawData.viewportClipRatios[proj.transformsIndex * 4];
+                    const FixedRect intersectionRect = proj.scissorRect.intersection(viewport.rect(viewportClipRatios));
+                    adjust = !intersectionRect.isEmpty() && (drawData.viewportOrigins[proj.transformsIndex] == G_EX_ORIGIN_NONE) &&
+                        (intersectionRect.ulx <= fbPair.scissorRect.ulx) && (intersectionRect.lrx >= fbPair.scissorRect.lrx) &&
+                        (intersectionRect.width(true, true) > intersectionRect.height(true, true));
+                }
+
+                narrowing = adjust ? (1.0f / aspectRatioScale) : 1.0f;
+            }
+
+            // Each triangle is cut where it crosses the near plane, z = -w in the game's clip space, so a triangle reaching
+            // past it boxes only what is drawn of it: a vertex behind the camera projects through the centre, and one
+            // just in front of it, which the GPU clips, far past the view. A cut's point is projected by the projection's
+            // viewport as the RSP projects posScreen.
+            const float centreX = float(viewport.translate.x);
+            auto nearDistance = [](const hlslpp::float4 &c) {
+                return float(c[2]) + float(c[3]);
+            };
+
+            float minX = 1e30f, minY = 1e30f, maxX = -1e30f, maxY = -1e30f;
+            auto addScreen = [&](float screenX, float screenY) {
+                const float sx = centreX + (screenX - centreX) * narrowing;
+                float x, y;
+                toTarget(sx / (fbWidth * 0.5f) - 1.0f, 1.0f - screenY / (fbHeight * 0.5f), x, y);
+                minX = std::min(minX, x);
+                maxX = std::max(maxX, x);
+                minY = std::min(minY, y);
+                maxY = std::max(maxY, y);
+            };
+
+            auto addClip = [&](const hlslpp::float4 &c) {
+                addScreen(float(c[0]) / float(c[3]) * float(viewport.scale.x) + float(viewport.translate.x),
+                    -float(c[1]) / float(c[3]) * float(viewport.scale.y) + float(viewport.translate.y));
+            };
+
+            const size_t vertexCount = std::min(drawData.posScreen.size(), drawData.posTransformed.size());
+            for (uint32_t i = 0; (i + 2) < desc.triangleCount * 3; i += 3) {
+                const size_t faceIndex = size_t(call.meshDesc.faceIndicesStart) + i;
+                if ((faceIndex + 2) >= drawData.faceIndices.size()) {
+                    break;
+                }
+
+                uint32_t v[3];
+                bool valid = true;
+                bool allFront = true;
+                for (uint32_t j = 0; j < 3; j++) {
+                    v[j] = drawData.faceIndices[faceIndex + j];
+                    valid = valid && (v[j] < vertexCount);
+                    allFront = allFront && valid && (nearDistance(drawData.posTransformed[v[j]]) > 0.0f);
+                }
+
+                if (!valid) {
+                    continue;
+                }
+
+                if (allFront) {
+                    for (uint32_t j = 0; j < 3; j++) {
+                        addScreen(float(drawData.posScreen[v[j]][0]), float(drawData.posScreen[v[j]][1]));
+                    }
+
+                    continue;
+                }
+
+                for (uint32_t j = 0; j < 3; j++) {
+                    const hlslpp::float4 &p = drawData.posTransformed[v[j]];
+                    const hlslpp::float4 &q = drawData.posTransformed[v[(j + 1) % 3]];
+                    const float pd = nearDistance(p), qd = nearDistance(q);
+                    if ((pd > 0.0f) && (float(p[3]) > 0.0f)) {
+                        addClip(p);
+                    }
+
+                    if ((pd > 0.0f) != (qd > 0.0f)) {
+                        const hlslpp::float4 cut = p + (q - p) * (pd / (pd - qd));
+                        if (float(cut[3]) > 0.0f) {
+                            addClip(cut);
+                        }
+                    }
+                }
+            }
+
+            if (minX <= maxX) {
+                x0 = minX;
+                y0 = minY;
+                x1 = maxX;
+                y1 = maxY;
+            }
+        }
+
+        const int32_t l = std::max(left, int32_t(std::floor(x0)));
+        const int32_t t = std::max(top, int32_t(std::floor(y0)));
+        const int32_t r = std::min(right, int32_t(std::ceil(x1)));
+        const int32_t b = std::min(bottom, int32_t(std::ceil(y1)));
+        if ((l >= r) || (t >= b)) {
+            return;
+        }
+
+        appendLine(drawsText, "D\t%llu\t%u\t%d\t%d\t%d\t%d\n", workloadId, desc.callIndex, l, t, r, b);
+    }
+};
diff --git a/src/hle/rt64_frame_dump.h b/src/hle/rt64_frame_dump.h
new file mode 100644
index 0000000..e470810
--- /dev/null
+++ b/src/hle/rt64_frame_dump.h
@@ -0,0 +1,553 @@
+//
+// RT64
+//
+
+#pragma once
+
+// RT64_FRAME_DUMP=<dir>, RT64_FRAME_DUMP_SECONDS=<from>-<to>: what a machine checks of a game's picture instead of an
+// eye, off unless the variable is set, for a desktop build or a test.
+//
+// - <dir>/frames.bin: every frame presented, the frames interpolated between the game's included, each as its 40-byte
+//   header (FrameHeader) and its pixels, 8-bit RGB, rows top down, the picture box-filtered to at most MaxWidth wide.
+//   A desktop build writes the pixels compressed (writeLoop()): the header's magic is MagicCompressed, and 8 more bytes
+//   follow it (CompressedHeader), the compressed size and whether the pixels are less the previous frame's, then that
+//   many bytes of zstd. A reader still reads a frame without the ones before it from the frame written whole at most
+//   KeyEvery frames before it, each header saying where the next one is. A 640x360 frame is 690 KB raw, 40 MB a second at
+//   60, and a dump of a whole plan was tens of GB a window: compressed it is about a third of that (Mario Golf's,
+//   3.4-3.7 times smaller less the previous frame, 1.8-2.1 alone), at 1-3 ms a frame on the writer's thread. A
+//   browser's build writes them raw (Magic), so its wasm carries no compressor.
+//   The picture is the box of the frame's color target the VI draws from (VIRenderer::render()'s videoResolution, from
+//   its top left corner), not the whole target, which can be larger: the targets of the frames drawn between the
+//   game's are kept at the largest size drawn (a 1692x960 target for a 1280x720 picture), and one kept from a larger
+//   frame before holds that frame's picture past the box. So every frame of a picture's size comes out the same size,
+//   with nothing past it. A frame flickering into a wrong picture for a frame between two right ones (a model paired with a
+//   look-alike's place, a frame drawn in parts) is a frame the frames either side of it don't explain, which only
+//   consecutive frames tell: a window's captures come tens of milliseconds apart, at a random point between the
+//   game's frames, and a person or a model looking at one doesn't read a tree standing where another one stood.
+// - <dir>/sides.tsv: for each workload the game's display lists drew (a line once the next one draws), how many of its triangles drawn through a
+//   perspective projection lie in each band of the picture's width (the middle of each one's span across it), in
+//   bands of the view's own width (BandsPerView a view) from one view left of it to one right, as
+//   "<workload's number in the dump>\t<ms since 1970>\t<count>\t<count>...". A game culls its world to its own 4:3 view, so with the
+//   picture widened (Expand) its triangles thin out past that view's sides, which no frame shows as a fault where
+//   water or sky lies under the culled ground. A triangle counts once, where it lies, not in every band it reaches
+//   over: the ground's large triangles near the camera reach past both sides whatever is culled.
+// - <dir>/draws.bin: what drew each frame, for a tool to say what covers a part of a flagged frame (the draws there,
+//   what the interpolation paired each with in the game frame before, whether a cut was taken) without a debug print,
+//   a rebuild and another play. A block for each game frame, its 16-byte header (DrawsHeader: magic, the size of what
+//   follows, the game frame's last workload's id) then its text, zstd (DrawsMagicCompressed) on a desktop build, raw
+//   (DrawsMagic) in a browser's. The text is lines of tab-separated fields, each line's first its kind:
+//     F <last workload id> <paired with the frame before (GameFrame::match() ran): 1/0>: the game frame.
+//     W <workload id> <the workload before it was paired with, or -> <camera cut: 1/0> <fb pairs>: each workload.
+//     C <workload id> <fb pair> <projection> <type> <call index> <triangles> <view-projection> <its pair in the
+//       workload before, or -> <first world transform> <last> <the first's pair, or -> <flags, or -: m moved unpaired
+//       with the camera, s its vertices its pair's> <first tile's texture hash, or -> <tiles> <flags, or -: c a tile
+//       copy, s synced> <the first tile paired: 1/0> <rect move, how far the frame before drew each edge from where
+//       this one does, ulx,uly,lrx,lry in the game's pixels, or -> <the game's rect, ulx,uly,lrx,lry, or ->: each
+//       call as GameFrame::match() paired it, type P perspective, O orthographic, R rect, F fill rect, T triangles.
+//     R <rendered frame> <its loop frame> <weight>: each frame drawn from the game frame, the game's own and each one
+//       between, in the order presented: a present's frame i is the game frame's rendered frame i (presents.tsv).
+//     B <workload id> <fb pair> <color image's address> <target width> <target height> <picture width> <picture height>:
+//       a framebuffer pair drawn, the picture its color image at the resolution scale, the box from the target's top
+//       left the VI shows (a target is kept at the largest size drawn), and
+//     D <workload id> <call index> <left> <top> <right> <bottom>: where each of its calls drew, in the target's pixels
+//       (frames.bin's picture is the target from its top left corner, scaled down), after its scissor, the widescreen
+//       origins and aspect, and for a rect the frame's rect moves: a rect exactly, triangles the box of what of them
+//       lies past the near plane in the game frame (the frames between move vertices on the GPU, so it is their
+//       place in the game's own frame). Only the frames presented: a framebuffer drawn for render-to-RAM on the game's
+//       thread writes none.
+//   About a hundredth of frames.bin's size (1.6 MB beside 129 MB for 7 s of a race at 120 frames a second).
+// - <dir>/presents.tsv: "<present id>\t<frame of the present>\t<frames it showed>\t<game frame's last workload id>" for
+//   each frame put in frames.bin, the game frame whose draws.bin block says what drew it.
+//
+// With RT64_FRAME_DUMP_SECONDS, only what comes between those seconds after the first present is written, a scene's
+// worth rather than gigabytes of the boot: about 40 MB a second of frames at 640 wide and 60 a second.
+//
+// With RT64_FRAME_DUMP_RATE=<Hz> too, RT64 presents at that rate whatever the display's is: the swap chain's vsync is
+// turned off (swapChainCreated()) and its rate taken as that one (swapChainRate()), so Framerate Display interpolates
+// to it. A desktop build presents frames between the game's only where the display is faster than the game, so a game
+// of 60 on a 59-60 Hz display presents none, and a dump of it tests nothing of how they pair: at 120 every other
+// frame is one of them. Where the device can't turn vsync off (Vulkan without its immediate present mode), the
+// presents stay held to the display's.
+//
+// The present thread copies each frame's picture into a buffer in that frame's own commands (plume's
+// copyTextureRegion into a placed footprint: D3D12, and Vulkan from the plume-web commit that adds it; Metal's reads
+// none back, so a desktop build's dump is for Windows and Linux), and box-filters it as the next frame is presented,
+// once those commands were waited for, which costs a present a few milliseconds: the dump is a test's, not a
+// player's. A frame's header is timed then, so a frame's time lags its own by one frame's.
+//
+// RT64 calls it from few places, the present queue's readback(), the RSP's addTriangle(), the application's
+// swapChainCreated(), the shared resources' swapChainRate(), the workload queue's addGameFrame() and
+// addRenderedFrame() and the framebuffer renderer's addDraw(), and everything else is here and in rt64_frame_dump.cpp:
+// a game's own changes to RT64 meet its lines in as few places as can be.
+//
+// Frames go to a thread of their own, about a second's in hand at most (MaxQueued, 44 MB of 640x360 frames: a dump of
+// Mario Golf's lost 22 frames at once to a stall of the writer, with 8 in hand, in one of three windows that dumped
+// the same scene): one that finds the queue full is dropped and counted in
+// the next header's dropped field, so a slow disk shows as a gap the tool knows, never as a slower game. The writer
+// stops writing frames, and says so once, when its disk has less than MinFreeBytes free: a dump run by hand, with no
+// tool watching its size, never fills the disk under the game and whatever else uses it.
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cmath>
+#include <condition_variable>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <deque>
+#include <filesystem>
+#include <memory>
+#include <mutex>
+#include <string>
