+        SDL_Event escape{};
+        escape.type = SDL_KEYDOWN;
+        escape.key.state = SDL_PRESSED;
+        escape.key.keysym.scancode = SDL_SCANCODE_ESCAPE;
+        escape.key.keysym.sym = SDLK_ESCAPE;
+        recompui::queue_event(escape);
+    }
+    had_lock = has_lock;
